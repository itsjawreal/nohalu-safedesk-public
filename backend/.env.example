# ============================================================
# Nohalu SafeDesk — contoh konfigurasi
# Salin menjadi `backend/.env` lalu isi nilainya.
# JANGAN commit `backend/.env`.
# ============================================================

# ---- Wajib untuk produksi ----
# Secret HMAC untuk menandatangani token sesi (min. 32 byte acak).
# Buat dengan: python -c "import secrets;print(secrets.token_urlsafe(48))"
# Bila kosong, server membuat secret acak sekali dan menyimpannya di samping
# file DB (mode 0600). Itu aman untuk lokal, tetapi sesi akan hangus bila file
# DB diganti — jadi set eksplisit di produksi.
NOHALU_SESSION_SECRET=

# Origin frontend yang boleh memanggil API (dipisah koma).
# Kosong = tidak ada origin lintas-domain yang diizinkan (same-origin tetap jalan).
NOHALU_CORS_ORIGINS=

# ---- Penyimpanan ----
# NOHALU_DB_PATH=./backend/data/safedesk.db
# NOHALU_FRONTEND_DIR=../app-nohalu-ui

# ---- LLM generatif (opsional) ----
# Tanpa bagian ini, SafeDesk tetap berjalan penuh dengan engine deterministik:
# retrieval, sitasi, konflik, refusal, PII masking, audit — semuanya aktif.
# LLM hanya lapisan penulisan ulang jawaban yang sudah lolos gate keamanan.
NOHALU_LLM_ENABLED=0
NOHALU_LLM_API_KEY=
NOHALU_LLM_BASE_URL=https://api.inceptionlabs.ai/v1/chat/completions
NOHALU_LLM_MODEL=mercury-3
NOHALU_LLM_REASONING=high
# NOHALU_LLM_TIMEOUT=90
# NOHALU_LLM_ATTEMPTS=3
# NOHALU_LLM_CB_THRESHOLD=4
# NOHALU_LLM_CB_COOLDOWN=45
# NOHALU_LLM_LEAK_THRESHOLD=3

# ---- Batas laju & kuota ----
# NOHALU_LOGIN_RATE_LIMIT=20
# NOHALU_CHAT_RATE_LIMIT=60
# NOHALU_READ_RATE_LIMIT=240
# NOHALU_REQUEST_RATE_LIMIT=30
# NOHALU_PUBLIC_RATE_LIMIT=120
# NOHALU_SESSION_TTL_HOURS=12
# NOHALU_SSE_MAX_PER_USER=4
# NOHALU_SSE_MAX_SECONDS=300

# ---- Aturan bisnis ----
# NOHALU_LEAVE_ENTITLEMENT=12
# NOHALU_LEAVE_LEAD_DAYS=3
# NOHALU_FINANCE_THRESHOLD=1000000
# NOHALU_MAX_REIMBURSEMENT=50000000
# NOHALU_MAX_UPLOAD_BYTES=10485760

# ---- Retensi & backup ----
# NOHALU_CHAT_RETENTION_DAYS=90
# NOHALU_BACKUP_ENABLED=1
# NOHALU_BACKUP_INTERVAL=86400
# NOHALU_BACKUP_KEEP=7
# NOHALU_BACKUP_DIR=./backups

# ---- Latar belakang (matikan saat menjalankan tes) ----
# NOHALU_REMINDERS=1
# NOHALU_REMINDER_INTERVAL=900

# ---- Logging ----
# NOHALU_LOG_LEVEL=info
